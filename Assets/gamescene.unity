  m_EditorClassIdentifier: Assembly-CSharp::PhishingGameController
  emails:
  - title: Spot all the phishings
    explanationCorrect: Nice! You found the urgent tone, suspicious link, and time
      pressure.
    explanationWrong: "This was a phishing email. Look for urgent language, strange
      domains, and time pressure like \u201C12 hours\u201D."
    segments:
    - text: Billing Department <billing@pay-alerts.info>\n\n
      isPhishing: 1
    - text: 'Subject: Urgent payment declined! Please update your card\n'
      isPhishing: 1
    - text: Hello Mark,\n
      isPhishing: 0
    - text: Your recent payment of 1,290 THB has failed.\n
      isPhishing: 0
    - text: To continue service, update your card details now at https://billing-resolve.com/update\n
      isPhishing: 1
    - text: If you do not respond in 12 hours, your account will be closed.\n
      isPhishing: 1
    - text: Thank you, Billing Team
      isPhishing: 0
  - title: Spot all the phishings
    explanationCorrect: Good job! You spotted the fake support address, the urgent
      threat, and the link asking you to log in on a non-official domain.
    explanationWrong: This was a phishing email. Notice the strange sender address,
      the scare tactic that your account will be suspended, and the login link that
      does not use the official streaming domain.
    segments:
    - text: Support Team <support@stream-fix-alert.com>\n
      isPhishing: 1
    - text: "Subject: Action required \u2013 your streaming subscription will be
        suspended\\n"
      isPhishing: 1
    - text: Hello Mark,\n
      isPhishing: 0
    - text: We were unable to process your latest monthly payment and your account
        is now at risk.\n
      isPhishing: 1
    - text: To avoid suspension, please log in and update your payment details at
        https://secure-stream-account.com/login\n
      isPhishing: 1
    - text: If you do not act within 24 hours, your access will be permanently removed.\n
      isPhishing: 1
    - text: Best regards, Streaming Customer Support\n
      isPhishing: 0
  - title: Spot all the phishings
    explanationCorrect: "Nice work! You caught the fake bank sender, the urgent security
      warning, and the login link that does not use the bank\u2019s real domain."
    explanationWrong: "This was a phishing email. Real banks don\u2019t use strange
      domains or push you to click random links to \u201Cverify\u201D your account."
    segments:
    - text: Security Department <alerts@online-securebank-check.com>\n
      isPhishing: 1
    - text: "Subject: Urgent \u2013 unauthorized login attempt detected on your account\\n"
      isPhishing: 1
    - text: Dear Customer,\n
      isPhishing: 0
    - text: We detected several failed login attempts from a new device.\n
      isPhishing: 0
    - text: To restore full access, verify your identity at https://secure-verify-bank.com\n
      isPhishing: 1
    - text: Otherwise, some online services may be temporarily unavailable.\n
      isPhishing: 0
    - text: Sincerely, Online Banking Security Team\n
      isPhishing: 0
  - title: Spot all the phishings
    explanationCorrect: "Correct! The fake courier address, vague \u201Cpackage on
      hold\u201D subject, and the payment link for a random fee are classic delivery-scam
      signs."
    explanationWrong: "This email is not legitimate. Real delivery companies don\u2019t
      ask you to pay surprise \u201Cprocessing fees\u201D through unknown payment
      sites."
    segments:
    - text: Delivery Notice <notify@parcel-update-shipping.net>\n
      isPhishing: 1
    - text: 'Subject: Package on hold at our distribution center\n'
      isPhishing: 1
    - text: Hello,\n
      isPhishing: 0
    - text: We tried to deliver a package, but there is a small customs processing
        fee.\n
      isPhishing: 0
    - text: Please pay the 89 THB fee at https://track-myparcel-pay.com to release
        the shipment.\n
      isPhishing: 1
    - text: If payment is not received, the package may be returned to the sender.\n
      isPhishing: 0
    - text: Thank you, Customer Delivery Support\n
      isPhishing: 0
  - title: Spot all the phishings
    explanationCorrect: "Well done \u2013 you noticed the non-official IT address
      and the password reset link on a suspicious domain with a short deadline."
    explanationWrong: "This was a phishing message. University IT normally points
      you to the official portal, not a random \u201Csecurity reset\u201D site with
      a 24-hour threat."
    segments:
    - text: IT Help Desk <support@uni-security-check.net>\n
      isPhishing: 1
    - text: 'Subject: Password reset notice for your university account\n'
      isPhishing: 0
    - text: Dear Student,\n
      isPhishing: 0
    - text: Our system has detected unusual activity on your login.\n
      isPhishing: 0
    - text: Please reset your password using the secure page at https://portal-security-reset.com\n
      isPhishing: 1
    - text: If you do not complete this reset within 24 hours, your access may be
        restricted.\n
      isPhishing: 1
    - text: Regards, University IT Services\n
      isPhishing: 0
  - title: Spot all the phishings
    explanationCorrect: Great catch! A surprise tax refund that asks for card details
      on a strange site and sets a short deadline is a strong indicator of phishing.
    explanationWrong: "This was a phishing email. Legitimate tax authorities don\u2019t
      send random refund links that ask for full card information and urgent action."
    segments:
    - text: Revenue Department <refunds@taxbenefit-support.org>\n
      isPhishing: 1
    - text: 'Subject: You are eligible for a tax refund\n'
      isPhishing: 0
    - text: Dear Taxpayer,\n
      isPhishing: 0
    - text: Our records show that you overpaid your taxes this year.\n
      isPhishing: 0
    - text: To receive your refund of 4,320 THB, please confirm your card details
        at https://quick-tax-refund.com\n
      isPhishing: 1
    - text: This refund offer will expire in 48 hours if no action is taken.\n
      isPhishing: 1
    - text: Best regards, National Revenue Service\n
      isPhishing: 0
